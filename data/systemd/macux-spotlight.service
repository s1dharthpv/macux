[Unit]
Description=MacUX Spotlight search
Documentation=https://github.com/macux/macux
PartOf=graphical-session.target
After=graphical-session.target macux.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=com.macux.Spotlight
ExecStart=python3 -m spotlight
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macux-spotlight

[Install]
WantedBy=graphical-session.target
