[Unit]
Description=MacUX Control Center
Documentation=https://github.com/macux/macux
PartOf=graphical-session.target
After=graphical-session.target macux.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=com.macux.ControlCenter
ExecStart=python3 -m control_center
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macux-control-center

[Install]
WantedBy=graphical-session.target
