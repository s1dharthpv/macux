[Unit]
Description=MacUX Launchpad application launcher
Documentation=https://github.com/macux/macux
PartOf=graphical-session.target
After=graphical-session.target macux.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=com.macux.Launchpad
ExecStart=python3 -m launchpad
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macux-launchpad

[Install]
WantedBy=graphical-session.target
