[Unit]
Description=MacUX Mission Control companion daemon
Documentation=https://github.com/macux/macux
PartOf=graphical-session.target
After=graphical-session.target macux.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=com.macux.MissionControl
ExecStart=python3 -m mission_control
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=macux-mission-control

[Install]
WantedBy=graphical-session.target
