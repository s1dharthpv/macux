[Icon Theme]
Name=MacUX
Comment=macOS-inspired icon theme for MacUX desktop environment
Inherits=Papirus,Papirus-Light,hicolor
Example=folder

# Directory definitions
Directories=scalable/apps,scalable/places,scalable/devices,scalable/status,scalable/actions,symbolic/apps,symbolic/places,symbolic/devices,symbolic/status,symbolic/actions,48x48/apps,48x48/status,32x32/apps,32x32/status,22x22/apps,22x22/status,16x16/apps,16x16/status

# ── Scalable (SVG) ────────────────────────────────────────────────────────────

[scalable/apps]
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/status]
Size=22
MinSize=8
MaxSize=128
Type=Scalable

[scalable/actions]
Size=22
MinSize=8
MaxSize=128
Type=Scalable

# ── Symbolic (monochrome) ─────────────────────────────────────────────────────

[symbolic/apps]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[symbolic/places]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[symbolic/devices]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[symbolic/status]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Status

[symbolic/actions]
Size=16
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions

# ── Fixed-size raster fallbacks ────────────────────────────────────────────────

[48x48/apps]
Size=48
Type=Fixed
Context=Applications

[48x48/status]
Size=48
Type=Fixed
Context=Status

[32x32/apps]
Size=32
Type=Fixed
Context=Applications

[32x32/status]
Size=32
Type=Fixed
Context=Status

[22x22/apps]
Size=22
Type=Fixed
Context=Applications

[22x22/status]
Size=22
Type=Fixed
Context=Status

[16x16/apps]
Size=16
Type=Fixed
Context=Applications

[16x16/status]
Size=16
Type=Fixed
Context=Status
